# Supabase (server-side, service role key — WAJIB tetap rahasia, jangan pernah dikirim ke frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# API AI untuk 3 AI Agent (Verification, Risk Prediction, Safe Route Advisor).
# Keputusan final: SEMUA agent memakai Gemini lewat GEMINI_API_KEY (WAJIB diisi),
# mis. Verification Agent (embedding + klasifikasi jenis kejadian) dan narasi
# Risk Prediction Agent. ANTHROPIC_API_KEY opsional, hanya opsi cadangan dan tidak
# dipakai modul manapun — biarkan kosong kecuali diminta dipakai secara eksplisit.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Mapbox Geocoding API (server-side) — dipakai backend untuk convert
# location_text laporan jadi koordinat, dibatasi area Yogyakarta.
# Kalau kosong, geocoding otomatis dilewati (laporan tetap tersimpan).
MAPBOX_TOKEN=

# Origin frontend yang diizinkan akses API (pisahkan dengan koma jika lebih dari satu)
CORS_ALLOW_ORIGINS=http://localhost:3000
